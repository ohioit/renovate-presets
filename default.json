{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Stock Renovate presets that form the base of this bundle. Listed alphabetically first so subsequent presets in this repo can override.",
    "Extend the built-in kubernetes manager to scan all YAML, and the helmfile and kustomize managers to also scan Jinja-templated YAML (`.yaml.j2` / `.yml.j2`).",
    "Extend the helm-values manager beyond its default `values.yaml` to HelmRelease-named files (plus their `.j2` variants).",
    "Extend every general-purpose preset in this repo. App-specific presets under apps/ are opt-in."
  ],
  "extends": [
    "config:best-practices",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigestsToSemver",
    ":disableRateLimiting"
  ],
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)values\\.ya?ml(?:\\.j2)?$/",
      "/(^|/)helmrelease\\.ya?ml(?:\\.j2)?$/",
      "/(^|/)helm-release\\.ya?ml(?:\\.j2)?$/",
      "/(^|/)hr\\.ya?ml(?:\\.j2)?$/"
    ]
  },
  "helmfile": {
    "managerFilePatterns": [
      "/(^|/)helmfile\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/",
      "/(^|/)helmfile\\.d/.+\\.ya?ml(?:\\.gotmpl)?(?:\\.j2)?$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.ya?ml(?:\\.j2)?$/"
    ]
  },
  "kustomize": {
    "managerFilePatterns": [
      "/(^|/)kustomization\\.ya?ml(?:\\.j2)?$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Process annotated dependencies: a `# renovate: datasource=<ds> depName=<name>` comment followed by a version assignment. Handles YAML values, quoted values, YAML anchors and KEY=value env lines.",
      "managerFilePatterns": [
        "/.*/"
      ],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+(:\\s|=)(&\\S+\\s)?[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Pick up `oci://...` URI references (Flux OCIRepository, Helm OCI charts, ...)",
      "managerFilePatterns": [
        "/\\.ya?ml(?:\\.j2)?$/"
      ],
      "matchStrings": [
        "oci://(?<depName>[^:]+):(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Override Helmfile dependency name to the full package name",
      "matchDatasources": [
        "docker"
      ],
      "matchManagers": [
        "helmfile"
      ],
      "overrideDepName": "{{packageName}}"
    },
    {
      "description": "Normalize packageName for mise github-releases tools so single-word names (`lefthook`) resolve to `lefthook/lefthook`",
      "matchFileNames": [
        ".mise.toml",
        ".mise/config.toml",
        "mise.toml"
      ],
      "matchDatasources": [
        "github-releases",
        "github-tags"
      ],
      "overridePackageName": "{{#if (lookup (split packageName '/') 1)}}{{packageName}}{{else if (lookup (split packageName ':') 1)}}{{ lookup (split packageName ':') 1 }}/{{ lookup (split packageName ':') 1 }}{{else}}{{packageName}}/{{packageName}}{{/if}}"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "semanticCommitType": "feat",
      "commitMessagePrefix": "{{semanticCommitType}}({{semanticCommitScope}})!:",
      "commitMessageExtra": "({{currentVersion}} ➔ {{newVersion}})"
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "semanticCommitType": "feat",
      "commitMessageExtra": "({{currentVersion}} ➔ {{newVersion}})"
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "semanticCommitType": "fix",
      "commitMessageExtra": "({{currentVersion}} ➔ {{newVersion}})"
    },
    {
      "matchUpdateTypes": [
        "digest"
      ],
      "semanticCommitType": "fix",
      "commitMessageExtra": "({{currentDigestShort}} ➔ {{newDigestShort}})"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "semanticCommitScope": "container",
      "commitMessageTopic": "image {{depName}}"
    },
    {
      "matchDatasources": [
        "helm"
      ],
      "semanticCommitScope": "helm",
      "commitMessageTopic": "chart {{depName}}"
    },
    {
      "matchDepTypes": [
        "HelmChart"
      ],
      "semanticCommitScope": "helm",
      "commitMessageTopic": "chart {{depName}}"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": "github-action",
      "commitMessageTopic": "action {{depName}}"
    },
    {
      "matchDatasources": [
        "github-releases"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "github-release",
      "commitMessageTopic": "release {{depName}}"
    },
    {
      "matchManagers": [
        "renovate-config"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "renovate-config",
      "commitMessageTopic": "config {{depName}}"
    },
    {
      "matchManagers": [
        "mise"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "mise",
      "commitMessageTopic": "tool {{depName}}"
    },
    {
      "description": "zer0ver: 0.x minors can break at any time, give them the breaking `!` prefix. No matchCurrentVersion guard is shipped for automerge: repo packageRules concatenate after presets, so add your own `matchCurrentVersion: \"!/^v?0/\"` if you automerge minors.",
      "matchUpdateTypes": [
        "minor"
      ],
      "matchCurrentVersion": "/^v?0\\./",
      "semanticCommitType": "feat",
      "commitMessagePrefix": "{{semanticCommitType}}({{semanticCommitScope}})!:",
      "commitMessageExtra": "({{currentVersion}} ➔ {{newVersion}})"
    },
    {
      "description": "zer0ver: 0.x minors can break at any time, route them onto the major branches. The default branchName template includes additionalBranchPrefix, so this lands them on the same major-<groupSlug> branch Renovate uses for grouped majors; ungrouped deps just get a major- branch rename.",
      "matchUpdateTypes": [
        "minor"
      ],
      "matchCurrentVersion": "/^v?0\\./",
      "additionalBranchPrefix": "major-"
    }
  ]
}
