{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "local>ohioit/renovate-presets",
    ":dependencyDashboard",
    ":semanticCommits",
  ],
  labels: ["renovate"],
  dependencyDashboardLabels: ["renovate"],
  packageRules: [
    {
      description: "The README's `# renovate:` comments are documentation examples, not dependencies",
      matchFileNames: ["README.md"],
      enabled: false,
    },
  ],
}
